---
layout: base.liquid
---

<h1>{{ title }}</h1>

<main>
  {% for post in posts %}
  <article>
    <h2>
      <a href="{{ post.url }}">
      {% if post.data.title %}
        {{ post.data.title }}
      {% else %}
        <time>{{ post.date | date: "%Y-%m-%d" }}</time>
      {% endif %}
      </a>
    </h2>
    <section>{{ post.content | raw }}</section>
    <time>{{ page.date | date: "%Y-%m-%d" }}</time>
  </article>
  {% endfor %}
</main>

<nav>
  {% if pagination.href.previous %}
  <a class="prev" href="{{ pagination.href.previous }}">前</a>
  {% endif %}
  {% if pagination.href.next %}
  <a class="next" href="{{ pagination.href.next }}">次</a>
  {% endif %}
  {% for ancestor in ancestors %}
  <a class="ancestor" href="{{ ancestor.url }}">{{ ancestor.title }}</a>
  {% endfor %}
</nav>
