---
layout: base.liquid
tags: post
---

{% assign prev = collections.diary | getPreviousCollectionItem: page %}
{% assign next = collections.diary | getNextCollectionItem: page %}

<main>
  <article>
    <h1>
    {% if title %}
      {{ title }}
    {% else %}
      <time>{{ page.date | date: "%Y-%m-%d" }}</time>
    {% endif %}
    </h1>
    <pre>{{ content | raw }}</pre>
    <time>{{ page.date | date: "%Y-%m-%d" }}</time>
  </article>
</main>

<nav>
  {% if prev %}
  <a class="prev" href="{{ prev.url }}">前</a>
  {% endif %}
  {% if next %}
  <a class="next" href="{{ next.url }}">次</a>
  {% endif %}
  {% for ancestor in ancestors %}
  <a class="ancestor" href="{{ ancestor.url }}">{{ ancestor.title }}</a>
  {% endfor %}
</nav>
